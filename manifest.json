{
  "schemaVersion": 1,
  "id": "resn3t.pomodoro",
  "name": "Pomodoro",
  "version": "1.9.0",
  "author": "resn3t",
  "description": "Pomodoro timer with bar-native controls, right-click settings, alert response tracking, and points",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Pomodoro",
    "description": "Left-click starts or pauses; right-click opens settings; skip with middle-click. Points + response tracking.",
    "category": "Productivity",
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "workMinutes": 25,
      "breakMinutes": 5,
      "longBreakMinutes": 15,
      "iterations": 4,
      "aiMessages": false
    },
    "schema": [
      {
        "key": "workMinutes",
        "type": "integer",
        "label": "Work duration (minutes)",
        "min": 1,
        "max": 240,
        "step": 1,
        "defaultValue": 25
      },
      {
        "key": "breakMinutes",
        "type": "integer",
        "label": "Break duration (minutes)",
        "min": 1,
        "max": 120,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "longBreakMinutes",
        "type": "integer",
        "label": "Long break duration (minutes)",
        "min": 1,
        "max": 240,
        "step": 1,
        "defaultValue": 15
      },
      {
        "key": "iterations",
        "type": "integer",
        "label": "Work sessions before long break",
        "min": 1,
        "max": 12,
        "step": 1,
        "defaultValue": 4
      },
      {
        "key": "aiMessages",
        "type": "boolean",
        "label": "Generate alert messages with a local AI (pi CLI + Ollama)",
        "defaultValue": false
      }
    ]
  }
}
